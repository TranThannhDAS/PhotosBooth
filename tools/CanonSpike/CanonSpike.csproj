<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike kiểm chứng Canon EDSDK trên .NET 10 (không thuộc solution chính).
    Chỉ chạy 64-bit vì repo chỉ chứa EDSDK.dll bản x64.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CanonSpike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\lib\EDSDK\win-x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
