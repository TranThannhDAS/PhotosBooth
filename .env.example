# Sao chép thành .env, nhập khóa riêng và tuyệt đối không commit .env.
# Sinh khóa ngẫu nhiên bằng PowerShell:
# [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
POSTGRES_PASSWORD=
UPLOAD_API_KEY=

# Tạo thư mục này trước khi khởi động Docker Compose trên Windows.
PHOTO_STORAGE_PATH=D:/PhotoboothData/Photos
CLOUD_PORT=5180
CLOUD_MAX_UPLOAD_MB=20

# Chỉ cho thử nghiệm local một instance; production nên chạy migration riêng.
DB_MIGRATE_ON_STARTUP=true

# Để trống khi chạy localhost. Khi công khai, cấu hình URL và hostname thật.
PUBLIC_BASE_URL=
ALLOWED_HOSTS=*

# Điền token rồi bật Docker Compose profile "tunnel" khi sẵn sàng.
CLOUDFLARE_TUNNEL_TOKEN=
