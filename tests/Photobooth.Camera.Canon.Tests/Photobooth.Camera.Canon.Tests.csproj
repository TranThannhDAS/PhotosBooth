<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test adapter Canon bằng SDK giả (không cần máy ảnh). Dùng cùng các package test như Photobooth.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Photobooth.Camera.Canon\Photobooth.Camera.Canon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kiểm tra các bộ thông số thật đi kèm ứng dụng đều hợp lệ (giống cách Photobooth.Tests kiểm tra Templates). -->
    <None Include="..\..\src\Photobooth.Desktop\CameraPresets\*.json" Link="CameraPresets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
