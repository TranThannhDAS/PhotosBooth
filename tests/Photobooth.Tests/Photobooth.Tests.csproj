<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kiểm tra các template thật đi kèm ứng dụng đều hợp lệ. -->
    <None Include="..\..\src\Photobooth.Desktop\Templates\**\*" Link="Templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Photobooth.Application\Photobooth.Application.csproj" />
    <ProjectReference Include="..\..\src\Photobooth.Infrastructure\Photobooth.Infrastructure.csproj" />
    <!-- Chỉ dùng cho kiểm thử end-to-end chia sẻ QR (Desktop upload → Cloud thật chạy trên 127.0.0.1). -->
    <ProjectReference Include="..\..\src\Photobooth.Cloud\Photobooth.Cloud.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dùng chung cách lấy PostgreSQL kiểm thử với Photobooth.Cloud.Tests (không sao chép code). -->
    <Compile Include="..\Photobooth.Cloud.Tests\TestPostgres.cs" Link="TestSupport\TestPostgres.cs" />
  </ItemGroup>

</Project>
