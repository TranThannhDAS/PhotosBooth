<Window x:Class="Photobooth.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="Photobooth Mini"
        Width="1280" Height="760"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorHost" HostPage="wwwroot\index.html" />

        <!--
            Màn hình dự phòng khi tiến trình WebView2 gặp sự cố.
            WebView2 là cửa sổ HWND nên phần tử WPF không thể nằm đè lên; khi hiện màn này phải ẩn BlazorHost.
        -->
        <Border x:Name="WebViewFailurePanel" Visibility="Collapsed" Background="#F8FAFC">
            <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Giao diện gặp sự cố" FontSize="28" FontWeight="SemiBold"
                           Foreground="#0F172A" TextAlignment="Center" />
                <TextBlock x:Name="WebViewFailureDetail" Margin="0,12,0,24" FontSize="16"
                           Foreground="#475569" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Ảnh đã chụp vẫn được giữ nguyên." />
                <Button x:Name="ReloadButton" Content="Tải lại giao diện" Click="OnReloadClicked"
                        MinHeight="56" Padding="24,0" FontSize="18" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
