@* Màn hình chào: một hành động chính duy nhất. Camera chưa được bật ở đây.
   Nút "Quản trị" nhỏ ở góc (theo yêu cầu chủ sản phẩm) mở hộp thoại PIN để vào lại Admin. *@
<div class="welcome">
    <div class="welcome-utilities">
        <FullscreenToggle />
        @if (OnAdmin.HasDelegate)
        {
            <button type="button" class="btn btn-ghost btn-sm welcome-admin" @onclick="OnAdmin">Quản trị</button>
        }
    </div>
    <div class="welcome-card">
        <div class="welcome-logo" aria-hidden="true">
            <BrandLogo Size="104" />
        </div>
        <h1 class="welcome-title">Photobooth Mini</h1>
        <p class="welcome-headline">Một lần chạm.<br />Một bộ ảnh thật bạn.</p>
        <p class="welcome-lead">Chọn khung yêu thích, tạo dáng và lưu lại khoảnh khắc.</p>

        <div class="welcome-actions">
            <button type="button" class="btn btn-primary btn-lg welcome-start"
                    disabled="@_starting" @onclick="StartAsync">
                Bắt đầu chụp
            </button>
            @if (OnGallery.HasDelegate)
            {
                <button type="button" class="btn btn-secondary welcome-gallery"
                        disabled="@_starting" @onclick="OnGallery">
                    Thư viện sự kiện
                </button>
            }
        </div>

        @if (Error is not null)
        {
            <StatusMessage Status="@(new StatusInfo(StatusKind.Error, Error))" />
        }

        <div class="welcome-journey" aria-label="Quy trình chụp ảnh">
            <span>01 · Chọn khung</span>
            <span>02 · Tạo dáng</span>
            <span>03 · Nhận ảnh</span>
        </div>
        <p class="welcome-note">Máy ảnh chỉ được bật khi bạn đến bước chụp.</p>
    </div>
</div>

@code {
    private bool _starting;

    [Parameter, EditorRequired]
    public EventCallback OnStart { get; set; }

    /// <summary>Lỗi khi tạo phiên (ví dụ mất thư mục sự kiện).</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Nhân viên bấm "Quản trị" (giao diện cha hiển thị hộp thoại PIN).</summary>
    [Parameter]
    public EventCallback OnAdmin { get; set; }

    /// <summary>Khách mở thư viện chỉ-xem của sự kiện hiện tại.</summary>
    [Parameter]
    public EventCallback OnGallery { get; set; }

    private async Task StartAsync()
    {
        // Chống bấm liên tục tạo nhiều phiên.
        if (_starting)
        {
            return;
        }

        _starting = true;
        await OnStart.InvokeAsync();
        _starting = false;
    }
}
