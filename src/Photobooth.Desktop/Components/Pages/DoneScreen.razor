@inherits SessionScreenBase
@inject WindowsShellService Shell

<SessionLayout Step="4">
    <ChildContent>
        <div class="done">
            <div class="done-icon" aria-hidden="true">✓</div>
            <h1>Hoàn thành!</h1>
            <p class="done-lead">Cảm ơn bạn đã sử dụng Photobooth. Ảnh của bạn đã được lưu lại.</p>

            @* QR thuộc đúng phiên bản khách vừa hoàn tất của phiên hiện tại; hiển thị ngay, không chờ upload. *@
            @if (Session?.CompletedOutput?.Share is { } share)
            {
                <ShareQrCard @key="share.Token" Link="share" />
            }
            else if (Sessions.ShareConfiguration.IsReady && Session?.CompletedOutput is not null)
            {
                <p class="panel-hint">Chưa tạo được mã QR cho ảnh này. Vui lòng báo nhân viên nếu bạn cần nhận ảnh qua điện thoại.</p>
            }

            <ul class="done-files">
                @foreach (var file in Session?.Exports ?? [])
                {
                    <li><strong>@UiText.FormatLabel(file.Format)</strong> — @Path.GetFileName(file.FilePath)</li>
                }
            </ul>
            @if (Session?.Exports.LastOrDefault() is { } last)
            {
                <button type="button" class="btn btn-secondary" @onclick="() => Shell.RevealFile(last.FilePath)">Mở thư mục</button>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="OnHome">Về màn hình chính</button>
        <div class="footer-group">
            @if (OnGallery.HasDelegate)
            {
                <button type="button" class="btn btn-secondary" @onclick="OnGallery">Thư viện sự kiện</button>
            }
            <button type="button" class="btn btn-primary btn-lg" @onclick="OnNewSession">Phiên mới</button>
        </div>
    </Footer>
</SessionLayout>

@code {
    [Parameter, EditorRequired]
    public EventCallback OnNewSession { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnHome { get; set; }

    /// <summary>Mở thư viện chỉ-xem của sự kiện hiện tại mà không làm mất phiên vừa hoàn thành.</summary>
    [Parameter]
    public EventCallback OnGallery { get; set; }

}
