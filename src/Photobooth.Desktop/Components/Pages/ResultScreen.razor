@inherits SessionScreenBase
@inject ILogger<ResultScreen> Logger

<SessionLayout Step="3" Class="screen-result" OnCancel="OnCancel" ConfirmCancel="@(Session?.Exports.Count == 0)" CancelDisabled="@(Busy || _showViewer)">
    <ChildContent>
        <div class="result-photo-first">
            <div class="result-photo-heading">
                <div>
                    <h1>Ảnh của bạn</h1>
                    <p>Chạm vào ô ảnh để chỉnh vùng cắt; chạm vùng trống quanh ảnh để phóng to.</p>
                </div>
                <div class="result-photo-actions">
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(!HasComposed || Busy)"
                            @onclick="() => _showViewer = true">Phóng to</button>
                </div>
            </div>

            @if (_message is not null)
            {
                <StatusMessage Status="@_message" />
            }

            <div class="result-photo-main">
                <div class="result-photo-stage">
                    <ComposedPreview @ref="_preview" Disabled="@Busy" OnMessage="ShowMessage"
                                     OnBackgroundClick="OpenViewer" />
                </div>

                <aside class="result-photo-sidebar" aria-label="Chỉnh sửa, bộ lọc và in ảnh thành phẩm">
                    <div class="result-photo-tools" aria-label="Công cụ chỉnh ảnh có thể cuộn">
                        <EditToolsPanel Preview="_preview" Disabled="@Busy" OnMessage="ShowMessage"
                                        ShowFilters="false" />

                    <section class="panel-section">
                        <h2 class="panel-title">Ảnh đã chụp</h2>
                        <div class="slot-strip" aria-label="Ảnh nguồn của phiên">
                            @if (Session is not null)
                            {
                                @for (var i = 0; i < Session.RequiredPhotoCount; i++)
                                {
                                    var position = i;
                                    var photo = Session.Slots[position];
                                    <div class="source-thumb">
                                        <div class="slot-thumb">
                                            @if (photo is not null)
                                            {
                                                <ImageView Class="slot-thumb-image" Key="@photo.PhotoId" Alt="@($"Ảnh {position + 1}")"
                                                           Loader="@(ct => Sessions.GetSlotPreviewAsync(position, 240, ct))" />
                                            }
                                            <span class="slot-thumb-number">@(position + 1)</span>
                                        </div>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@Busy" @onclick="() => Retake(position)">
                                            Chụp lại
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </section>

                        @* Bộ lọc màu là công cụ cuối trong vùng cuộn. *@
                        <ColorFilterPanel Disabled="@(_completing || _export?.IsExporting == true || _print?.IsPrinting == true)"
                                          OnMessage="ShowMessage" />
                    </div>

                    @* In ảnh đặt ngoài vùng cuộn, luôn dễ nhìn ở đáy cột phải. *@
                    <div class="result-photo-print" aria-label="In ảnh nhanh">
                        <PrintPanel @ref="_print" Disabled="@Busy" OnStateChanged="StateHasChanged" />
                    </div>
                </aside>
            </div>
        </div>

        @if (_showViewer && HasComposed)
        {
            <ResultPhotoViewer OnClose="CloseViewer" />
        }

        @if (_showSaveDialog)
        {
            <div class="dialog-backdrop result-modal-backdrop" @onclick="CloseSaveDialog">
                <section class="dialog result-modal-dialog result-save-dialog" role="dialog" aria-modal="true"
                         aria-labelledby="result-save-title" @onclick:stopPropagation="true">
                    <div class="result-modal-header">
                        <h2 id="result-save-title" class="dialog-title">Lưu ảnh thành phẩm</h2>
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="CloseSaveDialog">Đóng</button>
                    </div>
                    <div class="result-modal-content">
                        <ExportPanel @ref="_export" ShowSaveButton="true" AllowFolderChange="false"
                                     Disabled="@(IsComposing || _completing)" OnStateChanged="StateHasChanged" />
                    </div>
                </section>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="() => Sessions.ReturnToReview()">Quay lại xem ảnh</button>
        <div class="footer-group">
            <button type="button" class="btn btn-lg btn-secondary" disabled="@(!HasComposed || Busy)"
                    @onclick="() => _showSaveDialog = true">@(HasExports ? "Lưu thêm" : "Lưu ảnh")</button>
            @* Hoàn tất lưu thành phẩm trong thư mục sự kiện, không bắt buộc xuất file ra ngoài. *@
            <button type="button" class="btn btn-lg btn-primary" disabled="@(Busy || !HasComposed)" @onclick="CompleteAsync">
                @if (_completing)
                {
                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                    <span>Đang lưu…</span>
                }
                else
                {
                    <span>Hoàn tất</span>
                }
            </button>
        </div>
    </Footer>
</SessionLayout>

@code {
    private ComposedPreview? _preview;
    private PrintPanel? _print;
    private ExportPanel? _export;
    private StatusInfo? _message;
    private bool _completing;
    private bool _showViewer;
    private bool _showSaveDialog;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Mở chế độ xem lớn ngay khi bước Thành phẩm được tạo.
        // Nếu Photo Composer còn xử lý, hộp xem sẽ hiện khi ảnh đã sẵn sàng.
        _showViewer = true;
    }

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private bool IsComposing => Session?.State == PhotoSessionState.Composing;

    private bool Busy => IsComposing || _completing || _export?.IsExporting == true || _print?.IsPrinting == true;

    private bool HasComposed => Session?.Composed is not null;

    private bool HasExports => Session?.Exports.Count > 0;

    protected override void OnAfterRender(bool firstRender)
    {
        // Tham chiếu @ref chỉ có sau render đầu, cần render lại để các panel nhận được preview.
        if (firstRender)
        {
            StateHasChanged();
        }
    }

    private void ShowMessage(StatusInfo? message) => _message = message;

    private void CloseViewer() => _showViewer = false;

    private void OpenViewer()
    {
        if (!Busy && HasComposed)
        {
            _showViewer = true;
        }
    }

    private void CloseSaveDialog()
    {
        if (!Busy)
        {
            _showSaveDialog = false;
        }
    }

    private void Retake(int position)
    {
        if (Busy)
        {
            return;
        }

        Sessions.BeginRetake(position);
    }

    private async Task CompleteAsync()
    {
        if (Busy)
        {
            return;
        }

        _completing = true;
        _message = null;
        try
        {
            if (!await Sessions.CompleteSessionAsync())
            {
                _message = new StatusInfo(StatusKind.Error, "Chưa lưu được ảnh vào thư mục sự kiện.", "Kiểm tra ổ đĩa rồi thử lại. Ảnh đã chụp vẫn được giữ nguyên.");
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Lỗi ngoài dự kiến khi hoàn tất phiên");
            _message = UiText.UnexpectedError;
        }
        finally
        {
            _completing = false;
        }
    }
}
