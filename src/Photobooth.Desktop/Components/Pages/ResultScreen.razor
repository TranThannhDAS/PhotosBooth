@inherits SessionScreenBase
@inject ILogger<ResultScreen> Logger

<SessionLayout Step="3" OnCancel="OnCancel" ConfirmCancel="@(Session?.Exports.Count == 0)" CancelDisabled="@Busy">
    <ChildContent>
        <div class="result-layout">
            <div class="result-workspace">
                <div class="page-heading">
                    <h1>Ảnh của bạn</h1>
                    <p>Chạm vào ảnh để chỉnh vùng cắt. Chọn “Hoàn tất” khi đã ưng ý.</p>
                </div>
                <ComposedPreview @ref="_preview" Disabled="@Busy" OnMessage="ShowMessage" />
            </div>

            <aside class="side-panel" aria-label="Tùy chọn thành phẩm">
                @if (_message is not null)
                {
                    <StatusMessage Status="@_message" />
                }

                <EditToolsPanel Preview="_preview" Disabled="@(_completing || _export?.IsExporting == true)" OnMessage="ShowMessage" />

                <section class="panel-section">
                    <h2 class="panel-title">Ảnh đã chụp</h2>
                    <div class="slot-strip" aria-label="Ảnh nguồn của phiên">
                        @if (Session is not null)
                        {
                            @for (var i = 0; i < Session.RequiredPhotoCount; i++)
                            {
                                var position = i;
                                var photo = Session.Slots[position];
                                <div class="source-thumb">
                                    <div class="slot-thumb">
                                        @if (photo is not null)
                                        {
                                            <ImageView Class="slot-thumb-image" Key="@photo.PhotoId" Alt="@($"Ảnh {position + 1}")"
                                                       Loader="@(ct => Sessions.GetSlotPreviewAsync(position, 240, ct))" />
                                        }
                                        <span class="slot-thumb-number">@(position + 1)</span>
                                    </div>
                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@Busy" @onclick="() => Sessions.BeginRetake(position)">
                                        Chụp lại
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </section>

                <PrintPanel Disabled="@Busy" />

                <ExportPanel @ref="_export" ShowSaveButton="false" AllowFolderChange="false" Disabled="@(IsComposing || _completing)" OnStateChanged="StateHasChanged" />
            </aside>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="() => Sessions.ReturnToReview()">Quay lại xem ảnh</button>
        <div class="footer-group">
            <button type="button" class="btn btn-lg btn-secondary" disabled="@(!CanExport)" @onclick="ExportAsync">
                @if (_export?.IsExporting == true)
                {
                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                    <span>Đang lưu…</span>
                }
                else
                {
                    <span>@(HasExports ? "Lưu thêm" : "Lưu ảnh")</span>
                }
            </button>
            @* "Hoàn tất" lưu thành phẩm vào thư mục sự kiện (không bắt buộc xuất file ra ngoài). *@
            <button type="button" class="btn btn-lg btn-primary" disabled="@(Busy || Session?.Composed is null)" @onclick="CompleteAsync">
                @if (_completing)
                {
                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                    <span>Đang lưu…</span>
                }
                else
                {
                    <span>Hoàn tất</span>
                }
            </button>
        </div>
    </Footer>
</SessionLayout>

@code {
    private ComposedPreview? _preview;
    private ExportPanel? _export;
    private StatusInfo? _message;
    private bool _completing;

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private bool IsComposing => Session?.State == PhotoSessionState.Composing;

    private bool Busy => IsComposing || _completing || _export?.IsExporting == true;

    private bool HasExports => Session?.Exports.Count > 0;

    private bool CanExport => !Busy && Session?.Composed is not null && _export?.HasSelectedFormats == true;

    protected override void OnAfterRender(bool firstRender)
    {
        // Tham chiếu @ref chỉ có sau lần render đầu: render lại để các panel nhận được khung xem trước.
        if (firstRender)
        {
            StateHasChanged();
        }
    }

    private void ShowMessage(StatusInfo? message) => _message = message;

    private Task ExportAsync() => _export?.ExportAsync() ?? Task.CompletedTask;

    private async Task CompleteAsync()
    {
        if (Busy)
        {
            return;
        }

        _completing = true;
        _message = null;
        try
        {
            if (!await Sessions.CompleteSessionAsync())
            {
                _message = new StatusInfo(StatusKind.Error, "Chưa lưu được ảnh vào thư mục sự kiện.", "Kiểm tra ổ đĩa rồi thử lại. Ảnh đã chụp vẫn được giữ nguyên.");
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Lỗi ngoài dự kiến khi hoàn tất phiên");
            _message = UiText.UnexpectedError;
        }
        finally
        {
            _completing = false;
        }
    }
}
