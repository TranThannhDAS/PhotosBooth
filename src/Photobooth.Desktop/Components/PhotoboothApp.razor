@implements IDisposable
@inject PhotoSessionService Sessions
@inject AdminAccessService Admin
@inject EventWorkspaceService Workspaces

@*
    Component gốc. Màn hình hiển thị được SUY RA từ trạng thái phiên (PhotoSessionService),
    nên điều hướng luôn nhất quán với nghiệp vụ và khôi phục đúng chỗ khi giao diện được tải lại.
*@
<AppErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @* Màn khởi động/Admin chỉ có trước khi bắt đầu phục vụ khách (một lần mỗi lần mở ứng dụng). *@
        @if (!Admin.KioskStarted)
        {
            if (Admin.IsUnlocked)
            {
                <AdminScreen />
            }
            else
            {
                <StartupScreen />
            }
        }
        else
        {
        <div class="client-mode">
        @if (_showClientGallery && CanOpenClientGallery)
        {
            <ClientGalleryScreen @key="_galleryEventKey"
                                 BackLabel="@(CurrentScreen == AppScreen.Done ? "Quay lại màn hoàn thành" : "Về màn hình chính")"
                                 OnClose="CloseClientGallery" />
        }
        else
        {
            @switch (CurrentScreen)
            {
                case AppScreen.Welcome:
                    <WelcomeScreen OnStart="StartSession" Error="@_startError" OnAdmin="() => _askAdminPin = true" OnGallery="OpenClientGallery" />
                    break;
                case AppScreen.TemplateSelection:
                    <TemplateSelectionScreen OnCancel="CancelSession" />
                    break;
                case AppScreen.Capture:
                    <CaptureScreen OnCancel="CancelSession" />
                    break;
                case AppScreen.Review:
                    <ReviewScreen OnCancel="CancelSession" />
                    break;
                case AppScreen.Result:
                    <ResultScreen OnCancel="CancelSession" />
                    break;
                case AppScreen.Done:
                    <DoneScreen OnNewSession="StartSession" OnHome="GoHome" OnGallery="OpenClientGallery" />
                    break;
            }

            @if (_askAdminPin && CanOpenAdmin)
            {
                <PinDialog OnSubmit="TryOpenAdmin" OnCancel="() => _askAdminPin = false" />
            }
        }
        </div>
        }
    </ChildContent>
    <ErrorContent>
        <div class="fatal-error" role="alert">
            <h1>Đã xảy ra lỗi giao diện</h1>
            <p>Ảnh đã chụp vẫn được giữ nguyên. Nhấn nút bên dưới để quay về màn hình chính.</p>
            <button type="button" class="btn btn-primary btn-lg" @onclick="Recover">Về màn hình chính</button>
        </div>
    </ErrorContent>
</AppErrorBoundary>

@code {
    private enum AppScreen
    {
        Welcome,
        TemplateSelection,
        Capture,
        Review,
        Result,
        Done,
    }

    private AppErrorBoundary? _errorBoundary;
    private bool _atWelcome;
    private string? _startError;
    private bool _askAdminPin;
    private bool _showClientGallery;
    private string? _galleryEventKey;

    /// <summary>Chỉ vào Admin từ màn hình chào khi không có phiên chụp dang dở (không làm gián đoạn khách đang chụp).</summary>
    private bool CanOpenAdmin => CurrentScreen == AppScreen.Welcome && Sessions.Current is null or { IsEnded: true } or { IsArchived: true };

    /// <summary>Chỉ mở thư viện sự kiện từ màn Chào mừng hoặc Hoàn thành; không mở giữa các bước chụp/ghép/xuất.</summary>
    private bool CanOpenClientGallery => CurrentScreen is AppScreen.Welcome or AppScreen.Done
        && Sessions.Current is null or { IsEnded: true } or { IsArchived: true };

    private bool TryOpenAdmin(string pin)
    {
        if (!CanOpenAdmin || !Admin.TryReturnFromKiosk(pin))
        {
            return false;
        }

        _askAdminPin = false;
        _showClientGallery = false;
        return true;
    }

    private void OpenClientGallery()
    {
        if (!CanOpenClientGallery)
        {
            return;
        }

        _askAdminPin = false;
        _galleryEventKey = Workspaces.Current?.Info.EventId.ToString("N");
        _showClientGallery = true;
    }

    private void CloseClientGallery() => _showClientGallery = false;

    private AppScreen CurrentScreen
    {
        get
        {
            var session = Sessions.Current;
            if (_atWelcome || session is null)
            {
                return AppScreen.Welcome;
            }

            return session.State switch
            {
                PhotoSessionState.Created when session.Template is null => AppScreen.TemplateSelection,
                PhotoSessionState.Created or PhotoSessionState.Previewing or PhotoSessionState.Capturing => AppScreen.Capture,
                PhotoSessionState.Reviewing => AppScreen.Review,
                PhotoSessionState.Composing or PhotoSessionState.Ready => AppScreen.Result,
                PhotoSessionState.Completed => AppScreen.Done,
                _ => AppScreen.Welcome,
            };
        }
    }

    protected override void OnInitialized()
    {
        // Giao diện có thể được tải lại sau sự cố WebView2: phiên còn dang dở thì quay lại đúng bước.
        _atWelcome = Sessions.Current is null or { IsEnded: true };
        _galleryEventKey = Workspaces.Current?.Info.EventId.ToString("N");
        Sessions.SessionChanged += OnSessionChanged;
        Admin.Changed += OnAdminChanged;
        Workspaces.Changed += OnWorkspaceChanged;
    }

    private void StartSession()
    {
        _showClientGallery = false;

        // Không có thư mục sự kiện hợp lệ → không tạo phiên (không lưu ảnh sang chỗ khác).
        if (Sessions.StartNewSession() is null)
        {
            _startError = "Không truy cập được thư mục sự kiện. Vui lòng báo nhân viên kiểm tra ổ đĩa.";
            _atWelcome = true;
            return;
        }

        _startError = null;
        _atWelcome = false;
    }

    private void CancelSession()
    {
        _showClientGallery = false;
        Sessions.EndCurrentSession();
        _atWelcome = true;
    }

    private void GoHome()
    {
        _showClientGallery = false;
        _atWelcome = true;
    }

    private void Recover()
    {
        _showClientGallery = false;
        _atWelcome = true;
        _errorBoundary?.Recover();
    }

    private void OnSessionChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            if (!CanOpenClientGallery)
            {
                _showClientGallery = false;
            }

            StateHasChanged();
        });

    private void OnAdminChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            if (!Admin.KioskStarted)
            {
                _showClientGallery = false;
                _askAdminPin = false;
            }

            StateHasChanged();
        });

    private void OnWorkspaceChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            // Khi đổi sự kiện (Admin/workspace): đóng và reset gallery để bỏ mọi kết quả cũ.
            _showClientGallery = false;
            _galleryEventKey = Workspaces.Current?.Info.EventId.ToString("N");
            StateHasChanged();
        });

    public void Dispose()
    {
        Sessions.SessionChanged -= OnSessionChanged;
        Admin.Changed -= OnAdminChanged;
        Workspaces.Changed -= OnWorkspaceChanged;
    }
}
