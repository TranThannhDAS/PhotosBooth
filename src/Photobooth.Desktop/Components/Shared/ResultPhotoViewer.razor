@inherits SessionScreenBase
@inject WindowFullscreenService Fullscreen

@* Chế độ xem ảnh lớn độc lập với trạng thái toàn màn hình của cửa sổ WPF.
   Chạm vùng tối ngoài ảnh để đóng; nhấp vào ảnh/điều khiển không đóng. *@
<div class="dialog-backdrop result-viewer-backdrop" @onclick="CloseAsync">
    <section @ref="_viewer" tabindex="-1"
             class="result-viewer" role="dialog" aria-modal="true" aria-label="Xem lớn ảnh thành phẩm"
             @onkeydown="HandleKeyDown">
        <div class="result-viewer-toolbar" @onclick:stopPropagation="true">
            <strong>Xem ảnh thành phẩm</strong>
            <div class="result-viewer-buttons">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleZoom">
                    @(_zoomed ? "Vừa màn hình" : "Phóng to 200%")
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseAsync">
                    Đóng xem lớn
                </button>
            </div>
        </div>
        <div class="result-viewer-scroll @(_zoomed ? "is-zoomed" : null)" style="@ViewerStyle">
            @if (Session?.Composed is { } composed)
            {
                <div class="result-viewer-image-hit" @onclick:stopPropagation="true">
                    <ImageView Class="result-viewer-image" Key="@composed.FilePath" Alt="Ảnh thành phẩm phóng lớn"
                               Loader="@(ct => Sessions.GetComposedPreviewAsync(2400, ct))" />
                </div>
            }
        </div>
    </section>
</div>

@code {
    private ElementReference _viewer;
    private bool _zoomed;

    private string ViewerStyle => Session?.Template?.Canvas is { } canvas
        ? string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"--viewer-aspect: {canvas.WidthPixels} / {canvas.HeightPixels}; --viewer-ratio: {(double)canvas.WidthPixels / canvas.HeightPixels};")
        : "--viewer-aspect: 2 / 3; --viewer-ratio: 0.666667;";

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _viewer.FocusAsync();
        }
    }

    private void ToggleZoom() => _zoomed = !_zoomed;

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "F11")
        {
            // F11 điều khiển cửa sổ của toàn ứng dụng, không chỉ trình xem ảnh.
            if (Fullscreen.IsFullscreen)
            {
                Fullscreen.Exit();
            }
            else
            {
                Fullscreen.Enter();
            }
        }
        else if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
