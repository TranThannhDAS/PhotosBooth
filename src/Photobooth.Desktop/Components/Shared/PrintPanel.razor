@inherits SessionScreenBase
@inject ILogger<PrintPanel> Logger

@*
    Chọn số bản in và gửi yêu cầu in từ MỘT ảnh thành phẩm (số bản không liên quan số ảnh nguồn của template).
    Luôn có bước xác nhận; không báo "đã in xong" — chỉ "Windows đã tiếp nhận" hoặc "giả lập".
*@
<section class="panel-section">
    <h2 class="panel-title">In ảnh</h2>
    @if (Sessions.Printer is not { } printer)
    {
        <StatusMessage Status="@(new StatusInfo(StatusKind.Warning, "Chưa cấu hình máy in — chưa thể in.", "Bạn vẫn có thể lưu ảnh. Vui lòng liên hệ nhân viên nếu cần in."))" />
    }
    else
    {
        <p class="panel-hint">
            Máy in: <strong>@printer.Name</strong>
            @if (!printer.IsPhysical)
            {
                <span> — chế độ thử nghiệm, không in ra giấy.</span>
            }
        </p>
        <div class="copies-row">
            <span class="copies-label">Số bản</span>
            <div class="stepper" role="group" aria-label="Số bản in">
                <button type="button" class="btn btn-secondary stepper-btn" aria-label="Giảm số bản"
                        disabled="@(Busy || _copies <= 1)" @onclick="() => ChangeCopies(-1)">−</button>
                <output class="stepper-value" aria-live="polite">@_copies</output>
                <button type="button" class="btn btn-secondary stepper-btn" aria-label="Tăng số bản"
                        disabled="@(Busy || _copies >= MaxCopies)" @onclick="() => ChangeCopies(1)">+</button>
            </div>
            <small class="copies-max">Tối đa @MaxCopies bản</small>
        </div>
        <button type="button" class="btn btn-primary" disabled="@(Busy || !HasOutput)" @onclick="() => _confirming = true">
            @if (_printing)
            {
                <span class="spinner spinner-sm" aria-hidden="true"></span>
                <span>Đang gửi lệnh in…</span>
            }
            else
            {
                <span>In @_copies bản</span>
            }
        </button>
    }

    @if (_message is not null)
    {
        <StatusMessage Status="@_message" />
    }
</section>

@if (_confirming)
{
    <ConfirmDialog Title="@($"In {_copies} bản?")"
                   Message="@($"Ảnh thành phẩm này sẽ được gửi tới {Sessions.Printer?.Name ?? "máy in"} với {_copies} bản.")"
                   ConfirmText="In" CancelText="Không in"
                   OnConfirm="() => PrintAsync(confirmRetry: false)" OnCancel="() => _confirming = false" />
}

@if (_retryJob is { } unclear)
{
    <ConfirmDialog Title="In lại ảnh này?"
                   Message="@(unclear.Status == Photobooth.Application.Printing.PrintJobStatus.Failed
                               ? $"Lần in trước ({unclear.Copies} bản) đã thất bại. In lại {_copies} bản?"
                               : $"Lần in trước ({unclear.Copies} bản) chưa rõ đã in hay chưa. In lại có thể bị in trùng. Vẫn in {_copies} bản?")"
                   ConfirmText="Vẫn in" CancelText="Không in"
                   OnConfirm="() => PrintAsync(confirmRetry: true)" OnCancel="() => _retryJob = null" />
}

@code {
    private int _copies = 1;
    private bool _printing;
    private bool _confirming;
    private Photobooth.Application.Printing.PrintJob? _retryJob;
    private StatusInfo? _message;

    /// <summary>Phiên bản cần in; null = thành phẩm đang xem (được lưu thành phiên bản trước khi in).</summary>
    [Parameter]
    public int? Version { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private int MaxCopies => Sessions.PrintOptions.MaxCopies;

    private bool Busy => Disabled || _printing || Session?.State == PhotoSessionState.Composing;

    private bool HasOutput => Version is { } v ? Session?.FindVersion(v) is not null : Session?.Composed is not null;

    private void ChangeCopies(int delta) => _copies = Math.Clamp(_copies + delta, 1, MaxCopies);

    private async Task PrintAsync(bool confirmRetry)
    {
        _confirming = false;
        _retryJob = null;
        if (_printing)
        {
            return;
        }

        _printing = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await Sessions.RequestPrintAsync(_copies, Version, confirmRetry);
            _message = result.Outcome switch
            {
                Photobooth.Application.Printing.PrintOutcome.Submitted =>
                    new StatusInfo(StatusKind.Success, $"Đã gửi lệnh in {_copies} bản.", "Windows đã tiếp nhận lệnh in. Vui lòng chờ ảnh ra và kiểm tra máy in."),
                Photobooth.Application.Printing.PrintOutcome.Simulated =>
                    new StatusInfo(StatusKind.Info, $"Đã ghi nhận yêu cầu in {_copies} bản (chế độ thử nghiệm).", "Máy in giả lập — KHÔNG có bản in thật."),
                Photobooth.Application.Printing.PrintOutcome.NotConfigured =>
                    new StatusInfo(StatusKind.Warning, "Chưa cấu hình máy in — chưa thể in."),
                Photobooth.Application.Printing.PrintOutcome.InvalidCopies =>
                    new StatusInfo(StatusKind.Warning, $"Số bản phải từ 1 đến {MaxCopies}."),
                Photobooth.Application.Printing.PrintOutcome.Busy =>
                    new StatusInfo(StatusKind.Info, "Yêu cầu in vừa được gửi.", "Vui lòng chờ trước khi in tiếp để tránh in trùng."),
                Photobooth.Application.Printing.PrintOutcome.NothingToPrint =>
                    new StatusInfo(StatusKind.Error, "Không tìm thấy ảnh thành phẩm để in.", "File có thể đã bị di chuyển hoặc xóa."),
                Photobooth.Application.Printing.PrintOutcome.ConfirmationRequired => null,
                _ => new StatusInfo(StatusKind.Error, "Chưa in được.", (result.ErrorMessage ?? "Lỗi không xác định.") + " Ảnh vẫn được giữ nguyên."),
            };

            if (result.Outcome == Photobooth.Application.Printing.PrintOutcome.ConfirmationRequired)
            {
                _retryJob = result.Job;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Lỗi ngoài dự kiến khi gửi yêu cầu in");
            _message = new StatusInfo(StatusKind.Error, "Chưa in được.", "Ảnh vẫn được giữ nguyên. Vui lòng thử lại.");
        }
        finally
        {
            _printing = false;
        }
    }
}
