@inherits SessionScreenBase

@* Chỉnh vùng cắt thành phẩm; bộ lọc có thể đặt riêng phía cuối popup ở Kiosk. *@
<section class="panel-section">
    <h2 class="panel-title">Chỉnh sửa ảnh</h2>
    <p class="panel-hint">Chạm vào một ảnh trong khung (hoặc chọn ô bên dưới) để kéo và phóng to.</p>
    @if (Session?.Template is { } template)
    {
        <div class="chip-group" aria-label="Các ô ảnh">
            @for (var i = 0; i < template.Slots.Count; i++)
            {
                var slotIndex = i;
                var edited = Session.SlotCrops.ElementAtOrDefault(slotIndex) is not null;
                <button type="button" class="chip @(edited ? "is-active" : null)"
                        disabled="@(!CanEdit)" @onclick="() => OpenEditorAsync(slotIndex)">
                    @UiText.SlotLabel(slotIndex, template.Slots[slotIndex])
                </button>
            }
        </div>
    }
    <button type="button" class="btn btn-ghost btn-sm" disabled="@(!CanEdit || !HasCrops)" @onclick="() => Preview?.RequestResetAll()">
        Khôi phục chỉnh sửa
    </button>
</section>

@if (ShowFilters)
{
    <ColorFilterPanel Disabled="Disabled" OnMessage="OnMessage" />
}

@code {
    [Parameter]
    public ComposedPreview? Preview { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ShowFilters { get; set; } = true;

    [Parameter]
    public EventCallback<StatusInfo?> OnMessage { get; set; }

    [Parameter]
    public EventCallback OnEditOpened { get; set; }

    private bool CanEdit => !Disabled && Session is { Composed: not null, CanEdit: true, State: not PhotoSessionState.Composing };

    private bool HasCrops => Session?.SlotCrops.Any(c => c is not null) == true;

    private async Task OpenEditorAsync(int index)
    {
        if (!CanEdit || Preview is null)
        {
            return;
        }

        if (OnEditOpened.HasDelegate)
        {
            await OnEditOpened.InvokeAsync();
        }

        await Preview.OpenEditor(index);
    }
}
