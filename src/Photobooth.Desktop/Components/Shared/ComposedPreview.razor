@inherits SessionScreenBase

@*
    Xem trước thành phẩm của phiên hiện tại (Kiosk và chỉnh sửa lại trong Admin):
    khung đúng tỉ lệ canvas, ảnh là bản thu nhỏ của chính thành phẩm Photo Composer; vùng chọn ô đặt theo %
    tọa độ template; chạm vào ô → mở hộp ảnh (Manual Crop cho ô cover, xem trọn ảnh/chụp lại cho ô contain).
    Không có engine dựng ảnh thứ hai.
*@
<section class="result-preview" aria-label="Ảnh thành phẩm">
    @if (Session?.Template is { } template)
    {
        <div class="canvas-frame" style="@CanvasFrameStyle(template.Canvas)">
            <ImageView Class="result-image" Key="@PreviewKey" Alt="Ảnh thành phẩm"
                       Loader="@(ct => Sessions.GetComposedPreviewAsync(PreviewMaxWidth, ct))" />
            @foreach (var element in TemplateLayers.GetRenderOrder(template))
            {
                @* Chỉ ô ảnh có vùng chọn; hình/chữ/overlay không chặn thao tác. Ô vẽ sau (zIndex cao) nằm trên. *@
                if (element.Slot is not { } slot)
                {
                    continue;
                }

                var slotIndex = element.DeclarationOrder;
                var edited = Session.SlotCrops.ElementAtOrDefault(slotIndex) is not null;
                var slotLabel = UiText.SlotLabel(slotIndex, slot);
                var slotActionLabel = SlotCrop.IsSupported(slot) ? $"Chỉnh {slotLabel}" : $"Xem {slotLabel}";
                <button type="button"
                        class="slot-hit @(edited ? "is-edited" : null)"
                        style="@SlotHitStyle(template.Canvas, slot)"
                        title="@slotActionLabel"
                        aria-label="@slotActionLabel"
                        disabled="@(!CanEdit)"
                        @onclick="() => OpenEditor(slotIndex)">
                    @if (edited)
                    {
                        <span class="slot-hit-badge">Đã chỉnh</span>
                    }
                </button>
            }
        </div>
    }
    @if (IsComposing)
    {
        <div class="result-overlay" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <p>Đang tạo ảnh…</p>
        </div>
    }
    else if (Session is { Composed: null, LastCompositionFailed: true })
    {
        <div class="result-overlay result-overlay-error" role="alert">
            <p>Chưa tạo lại được ảnh thành phẩm.</p>
            <p class="result-overlay-detail">Ảnh gốc và các chỉnh sửa vẫn được giữ.</p>
            <button type="button" class="btn btn-primary" @onclick="RetryComposeAsync">Thử lại</button>
        </div>
    }
    else if (Session is { Composed: null, State: PhotoSessionState.Reviewing, CanEdit: true })
    {
        <div class="result-overlay" aria-live="polite">
            <p>Chưa có ảnh thành phẩm.</p>
            <button type="button" class="btn btn-primary" @onclick="RetryComposeAsync">Ghép ảnh</button>
        </div>
    }
</section>

@if (_editing is { } editing
     && Session is { Template: { } editTemplate } editSession
     && editSession.SessionId == editing.SessionId
     && editing.SlotIndex >= 0 && editing.SlotIndex < editTemplate.Slots.Count
     && editTemplate.Slots[editing.SlotIndex].PhotoIndex is var editPhotoIndex
     && editSession.Slots.ElementAtOrDefault(editPhotoIndex) is { } editPhoto)
{
    <CropEditor Template="editTemplate" SlotIndex="editing.SlotIndex" Photo="editPhoto"
                Confirmed="@editSession.SlotCrops.ElementAtOrDefault(editing.SlotIndex)"
                OnApply="ApplyCropAsync" OnCancel="CloseEditor"
                OnRetake="@(CanShowRetake(editSession, editPhotoIndex) ? EventCallback.Factory.Create(this, RetakeEditingSlotAsync) : default)"
                RetakeDisabled="@(!CanRetakeNow(editSession, editPhotoIndex))" />
}

@if (_confirmReset)
{
    <ConfirmDialog Title="Khôi phục chỉnh sửa?"
                   Message="Mọi ô ảnh sẽ quay về vùng cắt mặc định của khung (Auto Crop)."
                   ConfirmText="Khôi phục" CancelText="Giữ chỉnh sửa"
                   OnConfirm="ResetCropsAsync" OnCancel="() => _confirmReset = false" />
}

@code {
    /// <summary>Độ rộng ảnh xem trước (px); thành phẩm gốc vẫn ở độ phân giải canvas để xuất/in.</summary>
    private const int PreviewMaxWidth = 1200;

    private (Guid SessionId, int SlotIndex)? _editing;
    private bool _retaking;
    private bool _confirmReset;
    private string? _lastPreviewKey;

    /// <summary>Khóa thao tác chỉnh (ví dụ đang xuất/in).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Thông báo cho màn hình cha hiển thị (null = xóa thông báo).</summary>
    [Parameter]
    public EventCallback<StatusInfo?> OnMessage { get; set; }

    private bool IsComposing => Session?.State == PhotoSessionState.Composing;

    public bool CanEdit => !Disabled && !IsComposing && Session is { Composed: not null, CanEdit: true };

    /// <summary>
    /// Giữ ảnh đang hiển thị trong lúc ghép lại (thay vì để trống); ảnh chỉ được tải lại khi có thành phẩm mới,
    /// nên không bao giờ hiển thị kết quả cũ sau khi thành phẩm mới đã sẵn sàng.
    /// </summary>
    private string? PreviewKey
    {
        get
        {
            if (Session?.Composed?.FilePath is { } path)
            {
                _lastPreviewKey = path;
            }

            return _lastPreviewKey;
        }
    }

    private static string CanvasFrameStyle(TemplateCanvas canvas) => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"--canvas-aspect: {canvas.WidthPixels} / {canvas.HeightPixels}; --canvas-ratio: {(double)canvas.WidthPixels / canvas.HeightPixels};");

    private static string SlotHitStyle(TemplateCanvas canvas, TemplateSlot slot) => string.Create(
        System.Globalization.CultureInfo.InvariantCulture,
        $"left: {100.0 * slot.X / canvas.WidthPixels}%; top: {100.0 * slot.Y / canvas.HeightPixels}%; " +
        $"width: {100.0 * slot.Width / canvas.WidthPixels}%; height: {100.0 * slot.Height / canvas.HeightPixels}%;");

    /// <summary>Mở hộp ảnh của ô (chỉnh vùng cắt với ô cover; xem trọn ảnh/chụp lại với ô contain).</summary>
    public async Task OpenEditor(int slotIndex)
    {
        if (!CanEdit || Session is not { Template: { } template } session || slotIndex < 0 || slotIndex >= template.Slots.Count)
        {
            return;
        }

        var slot = template.Slots[slotIndex];
        if (slot.PhotoIndex < 0 || slot.PhotoIndex >= session.Slots.Count || session.Slots[slot.PhotoIndex] is null)
        {
            return;
        }

        await OnMessage.InvokeAsync(null);
        _editing = (session.SessionId, slotIndex);
        StateHasChanged();
    }

    /// <summary>Hỏi xác nhận rồi đưa mọi ô về Auto Crop.</summary>
    public void RequestResetAll()
    {
        if (CanEdit)
        {
            _confirmReset = true;
            StateHasChanged();
        }
    }

    private void CloseEditor() => _editing = null;

    private static bool CanShowRetake(PhotoSession session, int photoIndex) =>
        !session.IsArchived
        && !session.IsEnded
        && photoIndex >= 0
        && photoIndex < session.RequiredPhotoCount;

    private bool CanRetakeNow(PhotoSession session, int photoIndex) =>
        !Disabled
        && !IsComposing
        && !_retaking
        && CanShowRetake(session, photoIndex)
        && session.State is PhotoSessionState.Reviewing or PhotoSessionState.Ready;

    private async Task ApplyCropAsync(SlotCrop? crop)
    {
        if (_editing is not { } editing)
        {
            return;
        }

        _editing = null;
        if (Session is not { Template: { } template } session
            || session.SessionId != editing.SessionId
            || editing.SlotIndex < 0
            || editing.SlotIndex >= template.Slots.Count
            || !SlotCrop.IsSupported(template.Slots[editing.SlotIndex]))
        {
            return;
        }

        var outcome = await Sessions.ApplySlotCropAsync(editing.SlotIndex, crop);
        await OnMessage.InvokeAsync(outcome switch
        {
            CompositionOutcome.Failed => UiText.CompositionFailed,
            CompositionOutcome.NotReady or CompositionOutcome.Busy =>
                new StatusInfo(StatusKind.Warning, "Chưa áp dụng được chỉnh sửa.", "Vui lòng thử lại sau khi ảnh tạo xong."),
            _ => null,
        });
    }

    private async Task RetakeEditingSlotAsync()
    {
        if (_retaking || _editing is not { } editing)
        {
            return;
        }

        // Đóng hộp chỉnh và bỏ bản nháp crop chưa áp dụng (không gửi ApplySlotCropAsync).
        _editing = null;

        if (Disabled || IsComposing)
        {
            await OnMessage.InvokeAsync(new StatusInfo(
                StatusKind.Warning,
                "Chưa thể chụp lại lúc này.",
                "Vui lòng chờ thao tác hiện tại hoàn tất rồi thử lại."));
            return;
        }

        var session = Session;
        if (session is null
            || session.SessionId != editing.SessionId
            || session.IsArchived
            || session.IsEnded
            || session.Template is not { } template
            || editing.SlotIndex < 0
            || editing.SlotIndex >= template.Slots.Count)
        {
            await OnMessage.InvokeAsync(new StatusInfo(
                StatusKind.Warning,
                "Không thể chụp lại ảnh của ô này.",
                "Phiên chụp hoặc vị trí ô ảnh không còn hợp lệ."));
            return;
        }

        // SlotIndex là vị trí ô trong template, còn BeginRetake nhận photoIndex của ảnh nguồn.
        var photoIndex = template.Slots[editing.SlotIndex].PhotoIndex;
        if (photoIndex < 0 || photoIndex >= session.RequiredPhotoCount)
        {
            await OnMessage.InvokeAsync(new StatusInfo(
                StatusKind.Warning,
                "Không thể chụp lại ảnh của ô này.",
                "Vị trí ảnh nguồn của khung ảnh không hợp lệ."));
            return;
        }

        _retaking = true;
        try
        {
            if (Sessions.BeginRetake(photoIndex))
            {
                await OnMessage.InvokeAsync(null);
                return;
            }

            await OnMessage.InvokeAsync(new StatusInfo(
                StatusKind.Warning,
                "Chưa thể chụp lại ảnh này lúc này.",
                "Vui lòng thử lại khi phiên chụp đã sẵn sàng."));
        }
        finally
        {
            _retaking = false;
        }
    }

    private async Task ResetCropsAsync()
    {
        _confirmReset = false;
        await OnMessage.InvokeAsync(await Sessions.ResetAllSlotCropsAsync() == CompositionOutcome.Failed ? UiText.CompositionFailed : null);
    }

    private async Task RetryComposeAsync() =>
        await OnMessage.InvokeAsync(await Sessions.ComposeAsync() == CompositionOutcome.Failed ? UiText.CompositionFailed : null);
}
