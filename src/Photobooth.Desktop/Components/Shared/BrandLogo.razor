    <rect x="22" y="45" width="84" height="5" fill="#EFF6FF" />
    <rect x="30" y="44" width="12" height="7" rx="3.5" fill="#93C5FD" />
    <circle cx="92" cy="47.5" r="4.5" fill="#F59E0B" />

    <circle cx="64" cy="68" r="24" fill="#0F172A" />
    <circle cx="64" cy="68" r="20" fill="url(#pb-lens)" />
