@* Biểu tượng thương hiệu Photobooth Mini (SVG inline để hiển thị tức thì và sắc nét ở mọi DPI). *@
<svg class="brand-logo @Class"
     viewBox="0 0 128 128"
     width="@Size"
     height="@Size"
     fill="none"
     role="img"
     aria-hidden="true">
    <defs>
        <linearGradient id="pb-bg" x1="12" y1="8" x2="116" y2="120" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#3B82F6" />
