@implements IDisposable
@inject EventWorkspaceService Workspaces
@inject PhotoSessionService Sessions
@inject WindowsShellService Shell
@inject ILogger<EventWorkspacePicker> Logger

@*
    Tạo/mở lại sự kiện (Event Workspace) bằng hộp thoại chọn thư mục của Windows — không gõ đường dẫn. Dùng ở màn khởi động và trong Admin.
    - Tạo sự kiện mới: chọn NƠI LƯU + nhập tên → tự tạo thư mục con "{nơi lưu}\{tên sự kiện}", mọi ảnh của sự kiện nằm trong đó.
    - Mở sự kiện có sẵn: chọn đúng thư mục sự kiện đã tạo trước đó.
*@
<div class="event-picker">
    @if (Workspaces.Status is { Workspace: { } workspace } status)
    {
        <div class="event-current">
            <p class="event-label">Sự kiện hiện tại</p>
            @if (AllowRename)
            {
                <div class="event-name-row">
                    <label class="visually-hidden" for="event-name">Tên sự kiện</label>
                    <input id="event-name" class="text-input" type="text" maxlength="120" @bind="_name" @bind:event="oninput" disabled="@Busy" />
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(Busy || !CanSaveName)" @onclick="SaveNameAsync">Lưu và áp dụng</button>
                </div>
            }
            else
            {
                <p class="event-name">@workspace.Info.Name</p>
            }
            <p class="event-path" title="@workspace.RootDirectory">@workspace.RootDirectory</p>
            @if (status.FreeBytes is { } free)
            {
                <p class="event-meta">Dung lượng trống: @FormatBytes(free)</p>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Workspaces.Status.Folder))
    {
        <StatusMessage Status="@(new StatusInfo(StatusKind.Error, Workspaces.Status.Problem ?? "Thư mục sự kiện không dùng được.", Workspaces.Status.Folder))">
            <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="RecheckAsync">Thử lại</button>
        </StatusMessage>
    }
    else
    {
        <StatusMessage Status="@(new StatusInfo(StatusKind.Info, "Chưa chọn sự kiện.", "Tạo sự kiện mới (chọn nơi lưu và đặt tên) hoặc mở lại một sự kiện đã có."))" />
    }

    @if (ShowCreateForm)
    {
        <div class="event-new">
            <p class="event-label">Tạo sự kiện mới</p>
            <span class="event-label">Nơi lưu sự kiện</span>
            <div class="event-name-row">
                @if (_storageFolder is { } storage)
                {
                    <p class="event-path event-storage" title="@storage">@storage</p>
                }
                else
                {
                    <p class="event-meta event-storage">Chưa chọn nơi lưu.</p>
                }
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(Busy || Locked)" @onclick="PickStorageAsync">
                    @(_storageFolder is null ? "Chọn nơi lưu…" : "Đổi nơi lưu…")
                </button>
            </div>
            <label class="event-label" for="new-event-name">Tên sự kiện</label>
            <input id="new-event-name" class="text-input" type="text" maxlength="120" placeholder="Ví dụ: Đám cưới Lan & Minh"
                   @bind="_newName" @bind:event="oninput" disabled="@(Busy || Locked)" />
            @if (NewFolderPreview is { } preview)
            {
                <p class="event-meta">Thư mục sẽ được tạo: <span class="event-path" title="@preview">@preview</span></p>
            }
            else if (!string.IsNullOrWhiteSpace(_newName))
            {
                <p class="tpl-warning">Tên này không dùng được làm tên thư mục. Vui lòng đặt tên khác.</p>
            }
            <div class="event-actions">
                @if (Workspaces.Current is not null)
                {
                    <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="() => _creating = false">Hủy</button>
                }
                <button type="button" class="btn btn-primary" disabled="@(Busy || Locked || NewFolderPreview is null)" @onclick="CreateAsync">Tạo sự kiện</button>
            </div>
        </div>
    }

    @if (_message is not null)
    {
        <StatusMessage Status="@_message" />
    }

    <div class="event-actions">
        @if (!ShowCreateForm)
        {
            <button type="button" class="btn btn-secondary" disabled="@(Busy || Locked)" @onclick="BeginCreate">Tạo sự kiện mới</button>
        }
        <button type="button" class="btn btn-secondary" disabled="@(Busy || Locked)" @onclick="OpenExistingAsync">Mở sự kiện có sẵn…</button>
        @if (Workspaces.Current is { } current)
        {
            <button type="button" class="btn btn-ghost" disabled="@Busy" @onclick="() => OpenInExplorer(current.RootDirectory)">Mở thư mục</button>
        }
    </div>
    @if (Locked)
    {
        <p class="panel-hint">Không thể đổi sự kiện khi đang có phiên chụp chưa kết thúc.</p>
    }
</div>

@code {
    private string? _storageFolder;
    private bool _creating;
    private string _newName = string.Empty;
    private string _name = string.Empty;
    private StatusInfo? _message;
    private bool _busy;

    /// <summary>Cho phép đổi tên sự kiện (Admin).</summary>
    [Parameter]
    public bool AllowRename { get; set; }

    private bool Busy => _busy;

    /// <summary>Không đổi sự kiện khi một phiên chụp đang ghi dữ liệu.</summary>
    private bool Locked => Sessions.HasActiveSession;

    private bool CanSaveName =>
        Workspaces.Current is { } w && !string.IsNullOrWhiteSpace(_name) && !string.Equals(_name.Trim(), w.Info.Name, StringComparison.Ordinal);

    /// <summary>Form tạo sự kiện: luôn hiện khi chưa có sự kiện; đã có thì mở bằng nút "Tạo sự kiện mới".</summary>
    private bool ShowCreateForm => Workspaces.Current is null || _creating;

    /// <summary>Đường dẫn thư mục sẽ tạo (null nếu chưa chọn nơi lưu hoặc tên không dùng được).</summary>
    private string? NewFolderPreview =>
        _storageFolder is { } storage && EventFolderName.TryCreate(_newName, out var folderName)
            ? Path.Combine(storage, folderName)
            : null;

    protected override void OnInitialized()
    {
        Workspaces.Changed += OnWorkspaceChanged;
        _name = Workspaces.Current?.Info.Name ?? string.Empty;
        _storageFolder = Workspaces.SuggestedStorageFolder;
    }

    private void BeginCreate()
    {
        _message = null;
        _newName = string.Empty;
        _storageFolder ??= Workspaces.SuggestedStorageFolder;
        _creating = true;
    }

    private async Task PickStorageAsync()
    {
        _message = null;
        var folder = await FolderPicker.PickAsync("Chọn nơi lưu sự kiện (thư mục sự kiện sẽ được tạo bên trong)", _storageFolder);
        if (folder is not null)
        {
            _storageFolder = folder;
        }
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        if (_storageFolder is not { } storage)
        {
            _message = new StatusInfo(StatusKind.Warning, "Vui lòng chọn nơi lưu sự kiện.");
            return;
        }

        var status = await Workspaces.CreateEventAsync(storage, _newName);
        await ApplyResultAsync(status, "Đã tạo sự kiện mới.");
        if (status.IsReady)
        {
            _creating = false;
            _newName = string.Empty;
        }
    });

    private async Task OpenExistingAsync()
    {
        _message = null;
        var folder = await FolderPicker.PickAsync(
            "Chọn thư mục sự kiện đã tạo trước đó",
            Workspaces.Current?.RootDirectory is { } root ? Path.GetDirectoryName(root) : _storageFolder);
        if (folder is null)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var status = await Workspaces.OpenExistingAsync(folder);
            await ApplyResultAsync(status, "Đã mở lại sự kiện.");
            if (status.IsReady)
            {
                _creating = false;
            }
        });
    }

    private Task SaveNameAsync() => RunAsync(async () =>
        await ApplyResultAsync(await Workspaces.RenameAsync(_name), "Đã lưu tên sự kiện."));

    private Task RecheckAsync() => RunAsync(async () =>
        await ApplyResultAsync(await Workspaces.RecheckAsync(), "Thư mục sự kiện đã sẵn sàng."));

    private Task ApplyResultAsync(WorkspaceStatus status, string successTitle)
    {
        _message = status.IsReady
            ? new StatusInfo(StatusKind.Success, successTitle)
            : new StatusInfo(StatusKind.Error, status.Problem ?? "Thư mục sự kiện không dùng được.", status.Folder);
        _name = Workspaces.Current?.Info.Name ?? _name;
        return Task.CompletedTask;
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy || Locked)
        {
            return;
        }

        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            Logger.LogError(ex, "Lỗi khi chọn sự kiện");
            _message = new StatusInfo(StatusKind.Error, "Không mở được thư mục sự kiện.", "Kiểm tra ổ đĩa và quyền truy cập.");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenInExplorer(string folder)
    {
        if (!Shell.OpenFolder(folder))
        {
            _message = new StatusInfo(StatusKind.Warning, "Không mở được thư mục.", "Thư mục có thể đã bị di chuyển hoặc xóa.");
        }
    }

    private static string FormatBytes(long bytes) =>
        bytes >= 1L << 30 ? $"{bytes / (double)(1L << 30):0.#} GB" : $"{bytes / (double)(1L << 20):0} MB";

    private void OnWorkspaceChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Workspaces.Changed -= OnWorkspaceChanged;
}
