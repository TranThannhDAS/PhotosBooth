<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Cần chỉ định phiên bản Windows SDK: BlazorWebView .NET 10 dùng WebView2CompositionControl,
      control này phụ thuộc Microsoft.Windows.SDK.NET (chỉ có khi TFM ghi rõ windows10.0.17763.0 trở lên).
      Yêu cầu tối thiểu: Windows 10 1809.
    -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Photobooth.Desktop</RootNamespace>
    <AssemblyName>Photobooth</AssemblyName>
    <Product>Photobooth Mini</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.130" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <!-- Tạo mã QR offline cho link chia sẻ ảnh. QRCoder — giấy phép MIT, không phụ thuộc thêm package nào. -->
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template khung ảnh đi kèm ứng dụng (nạp lúc chạy, thêm template = thêm file JSON). -->
    <None Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bộ thông số máy ảnh Canon dựng sẵn (Admin › Camera): đi kèm mọi bản build/publish, file riêng cạnh .exe. -->
    <None Include="CameraPresets\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- appsettings.json luôn là file riêng cạnh .exe kể cả khi publish single-file. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Photobooth.Application\Photobooth.Application.csproj" />
    <ProjectReference Include="..\Photobooth.Infrastructure\Photobooth.Infrastructure.csproj" />
    <!-- Máy ảnh Canon qua EDSDK (kèm EDSDK.dll/EdsImage.dll x64): Admin › Camera (liệt kê, Live View, thông số). -->
    <ProjectReference Include="..\Photobooth.Camera.Canon\Photobooth.Camera.Canon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Templates\" />
  </ItemGroup>

</Project>
